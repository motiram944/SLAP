# Qdrant Cloud Free Tier Credentials (from https://cloud.qdrant.io)
QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Google Gemini Pro / Flash API Key (from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Groq API Key (from https://console.groq.com)
GROQ_API_KEY=
